# Telegram
TELEGRAM_BOT_TOKEN=
# Optional proxy for Bot API calls and file downloads: http://host:port or socks5://host:port
TG_PROXY=
# Optional local Bot API server root, default https://api.telegram.org
TELEGRAM_API_ROOT=

# Postgres (read by the client directly)
PGHOST=localhost
PGPORT=5432
PGUSER=gateway
PGPASSWORD=gateway
PGDATABASE=gateway

# giga-runner ASR, OpenAI-compatible base URL including /v1
ASR_BASE_URL=http://localhost:8000/v1
ASR_API_KEY=

WS_PORT=8080
HTTP_HEALTH_PORT=8081
LOG_LEVEL=info
GATEWAY_LABEL=Telegram
# Time zone for times shown in chat (/sessions)
DISPLAY_TZ=Europe/Moscow
